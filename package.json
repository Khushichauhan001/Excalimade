{
  "name": "excalimade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "server": "tsx watch server/index.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.2",
    "@vercel/blob": "^2.8.2",
    "nanoid": "^6.0.2",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "^4.6.6",
    "ws": "^8.22.0",
    "zustand": "^5.0.16",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
