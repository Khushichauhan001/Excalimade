# ---------------------------------------------------------------------------
# Excalimade environment variables. Copy to `.env` for local development.
# ---------------------------------------------------------------------------

# --- AI (Vercel project env + local .env) ----------------------------------
# Anthropic API key used server-side only by /api/ai/* (text to diagram, wireframe to code).
# Never exposed to the browser. Without it the AI dialogs show a setup message.
ANTHROPIC_API_KEY=
# Optional: override the Claude model used by the AI endpoints.
ANTHROPIC_MODEL=
# Optional: per-IP daily limits for the AI endpoints (defaults 30 / 10).
AI_DAILY_LIMIT_TEXT=30
AI_DAILY_LIMIT_WIREFRAME=10

# --- Storage (Vercel project env AND the Render relay) ---------------------
# Vercel Blob read/write token. Added automatically to the Vercel project when you connect a
# Blob store; copy the same value to the Render relay so room snapshots persist.
# Unset → files are stored on local disk under server/data (development only).
BLOB_READ_WRITE_TOKEN=
# "public" (default) or "private" — must match the access type chosen when creating the Blob store.
BLOB_ACCESS=public

# --- Realtime relay (frontend build env on Vercel) --------------------------
# WebSocket URL of the collaboration relay. Vercel can't host WebSockets, so the relay runs on
# Render. Leave empty locally (the dev server proxies /ws).
VITE_WS_URL=wss://excalimade-relay.onrender.com/ws
# Max size of a read-only share link upload in MB (Vercel's request limit is 4.5 MB).
VITE_SHARE_MAX_MB=4

# --- Relay server (Render env) ----------------------------------------------
# Comma-separated origins allowed to open collaboration sockets.
ALLOWED_ORIGINS=https://excalimade.vercel.app
# Port to listen on (Render sets this automatically).
PORT=3001
